# Environment Variables Template for Fixiq

# Server Environment
PORT=4000
NODE_ENV=development

# Database Connection (PostgreSQL 16)
DATABASE_URL="postgresql://fixiq_user:fixiq_password@localhost:5432/fixiq_dev?schema=public"

# Authentication & Security
JWT_SECRET="fixiq_super_secret_jwt_key_for_development_purposes_only_32_chars"
JWT_EXPIRES_IN="15m"

# Client CORS Configuration
CORS_ORIGIN="http://localhost:3000"
