{
  "name": "fixiq-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "Fixiq - Repair Intelligence Platform",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "powershell -ExecutionPolicy Bypass -File ./scripts/db.ps1 ensure && concurrently -k -p \"[{name}]\" -n \"API,WEB\" -c \"cyan,magenta\" \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "npm run dev --workspace=@fixiq/api",
    "dev:web": "npm run dev --workspace=@fixiq/web",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "db:generate": "npm run generate --workspace=@fixiq/database",
    "db:migrate": "npm run migrate --workspace=@fixiq/database",
    "db:push": "npx prisma db push --schema packages/database/prisma/schema.prisma",
    "db:seed": "npm run seed --workspace=@fixiq/database",
    "db:start": "powershell -ExecutionPolicy Bypass -File ./scripts/db.ps1 start",
    "db:stop": "powershell -ExecutionPolicy Bypass -File ./scripts/db.ps1 stop",
    "db:status": "powershell -ExecutionPolicy Bypass -File ./scripts/db.ps1 status"
  },
  "keywords": [
    "repair-intelligence",
    "electronics-repair",
    "micro-soldering",
    "diagnostics",
    "failure-patterns"
  ],
  "author": "Fixiq Contributors",
  "license": "MIT",
  "devDependencies": {
    "concurrently": "^10.0.5"
  }
}
